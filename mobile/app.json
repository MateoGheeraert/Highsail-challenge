{
  "expo": {
    "name": "Formcast",
    "slug": "formcast",
    "scheme": "formcast",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.formcast.mobile"
    },
    "android": {
      "package": "com.formcast.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
