NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full
# Optional unpooled Neon connection for Prisma migrations.
DIRECT_URL=
# Optional separate PostgreSQL database for integration tests.
TEST_DATABASE_URL=
BETTER_AUTH_URL=http://localhost:3000
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
TRUSTED_ORIGINS=http://localhost:8081,formcast://
DEMO_EMAIL=demo@mateo.be
# Set a password (at least 12 characters) before running db:seed.
DEMO_PASSWORD=
